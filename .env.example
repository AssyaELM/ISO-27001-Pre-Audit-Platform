# CapISO backend
APP_NAME=CapISO
APP_ENV=development
APP_SECRET_KEY=change-me

# Database
DATABASE_URL=postgresql+psycopg://capiso:capiso@localhost:5432/capiso

# Storage
STORAGE_ROOT=./storage

# AI providers are optional for the MVP foundation.
# Keep API keys only in the backend environment.
AI_PROVIDER=deterministic
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

